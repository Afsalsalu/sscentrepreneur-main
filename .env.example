DJANGO_ENV=development
SECRET_KEY=your-django-secret-key

DB_NAME=your-production-database-name
DB_USER=your-production-database-user
DB_PASSWORD=your-production-database-password
DB_HOST=your-production-database-host
DB_PORT=your-production-database-port

EMAIL_HOST=your-smtp-host
EMAIL_PORT=your-smtp-port
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=your-from-email
SMTP_HOST=your-smtp-host
SMTP_PORT=your-smtp-port
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
PSPDFKIT_API_KEY=your-pspdfkit-api-key
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
SENDINBLUE_API_KEY=your-sendinblue-api-key
BREVO_API_KEY=your-brevo-api-key
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# Private HTTPS sync to sscegov.com (never commit real values)
SSCEGOV_SYNC_ENDPOINT=https://sscegov.com/api/integrations/sscentrepreneur/exam-qualified-user/
SSCEGOV_SYNC_API_KEY=replace-with-a-long-random-api-key
SSCEGOV_SYNC_HMAC_SECRET=replace-with-a-long-random-hmac-secret

# The destination uses the same shared values under its own setting names.
SSCEGOV_INTEGRATION_API_KEY=replace-with-the-same-long-random-api-key
SSCEGOV_INTEGRATION_HMAC_SECRET=replace-with-the-same-long-random-hmac-secret
